{
  "name": "stall-cashier-system",
  "version": "0.7.13",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node payments/web.cjs",
    "online:start": "node online/server.cjs",
    "online:bootstrap": "node online/bootstrap.cjs",
    "coupons:start": "node coupons/server.cjs",
    "test": "node --env-file-if-exists=.env.local --test tests/*.test.js",
    "lottery:preview": "node scripts/preview-lottery-catalog.cjs",
    "dev": "vite --host 0.0.0.0",
    "desktop": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "scarf:preview": "node scripts/preview-scarf-cashier.cjs",
    "activities:preview": "node scripts/preview-dual-lottery.cjs",
    "preactivities:preview": "npm run build -- --outDir output/dual-lottery-20261008/preview-dist",
    "prelottery:preview": "npm run build -- --outDir output/lottery-catalog-20260930/preview-dist",
    "prescarf:preview": "npm run build -- --outDir output/scarf-cashier-20261008/preview-dist"
  },
  "build": {
    "appId": "com.stall.cashier",
    "productName": "摆摊收银台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "payments/**/*",
      "coupons/*.cjs",
      "src/orderLogic.js",
      "src/afterSales.js",
      "src/vendor/jsbarcode-LICENSE.txt",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@zxing/browser": "^0.1.5",
    "json-source-map": "0.6.1",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.10",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  }
}
