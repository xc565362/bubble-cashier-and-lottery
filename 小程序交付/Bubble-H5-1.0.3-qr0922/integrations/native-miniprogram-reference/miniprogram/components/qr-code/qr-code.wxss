.qr-wrap{position:relative;width:420rpx;height:420rpx;max-width:280px;max-height:280px;background:#fff;margin:0 auto}
.qr{width:100%;height:100%;display:block}
.qr-error{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:12px;background:#fff;font-size:14px;line-height:1.5;color:#9f2a11;text-align:center}
