.nav{position:fixed;bottom:0;left:0;right:0;z-index:10;display:flex;background:#fff9e7;border-top:1rpx solid #e9bb98;padding:18rpx 12rpx;padding-bottom:calc(18rpx + env(safe-area-inset-bottom))}.item{margin:0;width:33.33%;padding:0;display:flex;align-items:center;flex-direction:column;gap:5rpx;border:0;color:#69402d;background:transparent;font-size:20rpx;line-height:1.5}.item::after{border:0}.selected{color:#69402d}.icon{font-size:40rpx;line-height:1.1;height:45rpx}

.nav{background:#fff9e7;border-color:#edc5a3}.item{color:#956846}.selected{color:#b93010;font-weight:700}
