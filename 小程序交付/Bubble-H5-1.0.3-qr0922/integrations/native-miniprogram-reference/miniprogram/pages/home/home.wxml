<view class="screen"><brand-header/><view class="hero"><view class="kicker">— FOR EVERY FINISHER</view><view class="hero-title">此刻在地<view class="pink">赛场同行</view></view><view class="hero-copy">扫码抽完赛助力礼，好运即刻出发。</view><view class="seal"><text>每一份热爱</text><view class="percent">100<text>%</text></view><text>都有回响</text></view></view>
<view wx:if="{{loading}}" class="loading">正在加载活动…</view><view wx:elif="{{error}}" class="error-box">{{error}}<button class="secondary" bindtap="load">重新加载</button></view>
<view wx:else class="content"><view class="section-label">你的赛场好运<text class="en">8 重好礼 · 100% 中奖</text></view><view class="lottery-card"><view class="board-meta"><text>{{inventory ? inventory.total + ' 份好礼' : '完赛有礼'}}{{inventory && inventory.remaining !== null ? ' · 剩余 ' + inventory.remaining + ' 份' : ''}}</text><text>GOOD LUCK</text></view><view class="prize-grid"><block wx:for="{{grid}}" wx:key="id"><button wx:if="{{item.id==='draw'}}" class="prize-tile draw-tile" bindtap="draw" disabled="{{drawing || (!entry && drawError)}}"><text class="sparkle">✦</text><view class="draw-title">{{drawing?'好运':entry?'查看':drawError?'暂未':'立即'}}<view>{{drawing?'揭晓中':entry?'奖品':drawError?'开放':'抽奖'}}</view></view><text class="draw-small">{{drawing?'请稍候':entry?'好运已经到账':'点击收获好运'}}</text></button><view wx:else class="prize-tile {{activeId===item.id?'active':''}}"><text class="probability">初始 {{item.probability}}%</text><prize-art prize="{{item}}"/><text class="prize-name">{{item.shortName}}</text></view></block></view><view class="board-foot">{{entry?'你已参与本次抽奖 · 前往我的奖品领取':drawError || '每人 1 次 · 有名额时必中 · 发完即止'}}</view></view><view class="minor-copy"><text>好运不落空，每一份热爱都有回响。</text><button class="text-button" bindtap="openRules">查看规则 ↗</button></view><view class="section-label">三步，把好礼带走<text class="en">HOW TO PLAY</text></view><view class="steps"><view class="step"><text class="number">01</text><text class="title">参与抽奖</text><text class="desc">点击按钮，开启好运</text></view><view class="step"><text class="number">02</text><text class="title">出示条形码</text><text class="desc">在「我的奖品」查看</text></view><view class="step"><text class="number">03</text><text class="title">购物用券／领礼</text><text class="desc">金额券购物用，实物现场领</text></view></view><view class="location"><text>⌖</text><text>领取地点：{{campaign.venue}}</text><text>现场核销</text></view><view class="art-note">奖品插画仅供示意，请以现场实物为准</view><button wx:if="{{isDemo}}" class="reset" bindtap="resetDemo" disabled="{{drawing}}">重置演示 ↻</button></view><bottom-nav active="home" locked="{{drawing}}"/></view>
<view wx:if="{{showResult}}" class="modal-backdrop" catchtouchmove="noop"><view class="modal"><view class="sparkles">✦ · ✧ · ✦</view><view class="overline">A LITTLE LUCK FOR YOU</view><view class="title">好运，就在此刻</view><view class="subtitle">恭喜你抽中了</view><view class="large-art"><prize-art prize="{{result.prize}}"/></view><view class="win-name">{{result.prize.name}}</view><view class="subtitle">{{result.checkoutCoupon?'购物结算前出示券码，付款成功后核销。':'带上这份好运，到活动展位领取吧。'}}<view wx:if="{{isDemo}}">演示奖品不产生真实领取资格</view></view><button class="primary" bindtap="openPrize">查看领取凭证 →</button><button class="later" bindtap="closeResult">稍后查看</button></view></view>
