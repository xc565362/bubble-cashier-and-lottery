# WeChat mini-program credentials. Mock mode is enabled when WX_MOCK=1
# or WX_SECRET is empty: no WeChat calls are made and each distinct login
# code maps to a stable local test user.
WX_APPID=
WX_SECRET=
WX_MOCK=

# Shared secret for staff/cashier operations (lookup/redeem/admin).
# Send as header: X-Staff-Key: <value>
STAFF_KEY=

# Optional comma-separated WeChat openids that count as staff in the H5.
STAFF_OPENIDS=

# HTTP port (default 8787).
PORT=

# MySQL connection (tables must already exist; see README).
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Coupon-center bridge (optional; all three must be set together).
# Cash prizes are minted as real coupons in the coupon center, pinned to the
# entry's 16-hex code so the winner's QR scans at the cashier till.
# COUPON_CAMPAIGN_ID is the coupon-center campaign id the key is scoped to and
# covers the cash prizes whose face value matches it. For multiple face values
# run scripts/provision-coupons.mjs instead; it writes .coupon-bridge.json,
# which is loaded when these variables are absent.
COUPON_CENTER_URL=
COUPON_LOTTERY_KEY=
COUPON_CAMPAIGN_ID=

# Set to "off" to force-disable the bridge for a process (dev/e2e runs)
# without deleting .coupon-bridge.json.
COUPON_BRIDGE=
