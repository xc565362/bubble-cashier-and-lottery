.hero{padding:44rpx 43rpx 40rpx;position:relative;overflow:hidden;background:#fff9e7}.hero-title{font-size:71rpx;line-height:1.34;font-weight:900;letter-spacing:4rpx;margin:24rpx 0 18rpx}.pink{color:#69402d}.hero-copy{font-size:21rpx;color:#69402d;letter-spacing:1rpx}.seal{position:absolute;right:50rpx;top:84rpx;width:131rpx;height:131rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;border:1rpx solid #e9bb98;border-radius:50%;transform:rotate(12deg);background:#fff9e7;font-size:16rpx;color:#69402d}.percent{font-family:Arial,sans-serif;font-weight:800;font-style:italic;font-size:44rpx;margin:4rpx 0}.percent text{font-size:23rpx}.lottery-card{background:#fff9e7;border:2rpx solid #e9bb98;padding:23rpx;border-radius:31rpx;box-shadow:none}.board-meta{display:flex;justify-content:space-between;font-size:19rpx;padding:0 3rpx 20rpx;color:#69402d}.board-meta text:last-child{font-size:17rpx;color:#69402d}.prize-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13rpx}.prize-tile{position:relative;height:193rpx;background:#fff9e7;color:#69402d;border-radius:18rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;padding:30rpx 5rpx 14rpx;box-shadow:none}.probability{position:absolute;right:11rpx;top:10rpx;font-size:17rpx;color:#69402d}.prize-name{font-size:19rpx;font-weight:600;margin-top:8rpx;white-space:nowrap}.draw-tile{padding:0;background:#fff9e7;color:#69402d;box-shadow:none;border:2rpx solid #e9bb98}.draw-tile[disabled]{opacity:1}.draw-title{font-size:36rpx;line-height:1.4;font-weight:800;letter-spacing:3rpx}.sparkle{font-size:29rpx;height:33rpx;margin-bottom:6rpx}.draw-small{font-size:17rpx;margin-top:9rpx}.active{background:#fff9e7;box-shadow:none;transform:scale(.97)}.board-foot{text-align:center;font-size:17rpx;color:#69402d;margin-top:22rpx;line-height:1.6}.minor-copy{display:flex;justify-content:space-between;align-items:center;font-size:17rpx;color:#69402d;margin:23rpx 0 42rpx}.steps{display:flex;margin:32rpx 0 40rpx}.step{width:33.33%;display:flex;flex-direction:column;align-items:center}.step .number{font-family:Arial,sans-serif;font-size:37rpx;font-weight:600;font-style:italic;color:#69402d;margin-bottom:15rpx}.step .title{font-size:21rpx;font-weight:600;margin-bottom:8rpx}.step .desc{font-size:17rpx;color:#69402d}.location{display:flex;align-items:center;gap:17rpx;padding:24rpx;background:#fff9e7;border:1rpx solid #e9bb98;border-radius:18rpx;color:#69402d;font-size:20rpx}.location text:first-child{font-size:32rpx;color:#69402d}.location text:last-child{margin-left:auto;font-size:17rpx;color:#69402d}.art-note{text-align:center;color:#69402d;font-size:16rpx;margin-top:23rpx}.reset{font-size:20rpx;color:#69402d;padding:17rpx;margin-top:12rpx}
.hero-mountains{position:absolute;right:-150rpx;top:-70rpx;width:730rpx;height:550rpx;opacity:.8;pointer-events:none}.hero .kicker,.hero-title,.hero-copy{position:relative;z-index:1}.seal{z-index:1}

.hero{background:#ff652e}.hero-title,.pink{color:#fff9e7}.hero-copy,.hero .kicker{color:#63230f}.hero-mountains{display:none}.seal{background:#fff9e7;border-color:#fff9e7;color:#b63012;transform:none}.lottery-card{background:#b93010;border:0;padding:22rpx}.board-meta,.board-meta text:last-child,.board-foot{color:#fff9e7}.prize-tile{background:#fff9e7;color:#582312}.probability{color:#9c5734}.draw-tile{background:#ff652e;color:#fff9e7;border:2rpx solid #ff652e}.active{background:#ffe18b;box-shadow:0 0 0 5rpx #fff9e7;transform:scale(.97)}.sparkle{display:none}.draw-small{color:#fff9e7}.minor-copy,.step .desc{color:#762b14}.step .number{color:#9f2a11}.location{background:#fff9e7;color:#69402d;align-items:flex-start}.location text:nth-child(2){flex:1}.location text:last-child{color:#8b3c1d;white-space:nowrap}.art-note,.reset{color:#762b14}
