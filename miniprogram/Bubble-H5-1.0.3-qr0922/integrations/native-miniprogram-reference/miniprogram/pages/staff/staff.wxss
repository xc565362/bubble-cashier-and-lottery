.staff-form{margin:0 38rpx 35rpx;padding:36rpx;background:#fff9e7;border:1rpx solid #e9bb98;border-radius:26rpx}.tip{font-size:22rpx;line-height:1.9;color:#69402d;margin-bottom:24rpx}.label{font-size:24rpx;color:#69402d;margin:30rpx 0 18rpx}.input{border:1rpx solid #e9bb98;border-radius:16rpx;background:#fff9e7;color:#69402d;font-size:29rpx;font-family:Consolas,monospace;width:100%;height:93rpx;padding:20rpx;margin-bottom:27rpx}.placeholder{color:#69402d;font-size:24rpx}.staff-result{margin:38rpx;padding:40rpx;text-align:center;border-radius:26rpx;border:1rpx solid #e9bb98;background:#fff9e7}.name{font-size:44rpx;font-weight:650;margin:25rpx 0}.code{font-size:27rpx;font-family:Consolas,monospace;color:#69402d;line-height:1.8;margin-bottom:30rpx}.staff-result .primary{margin-top:30rpx}
.activity-code{margin-top:24rpx}

.staff-form,.staff-result{background:#fff9e7}.input{background:#fff;color:#241812}.name{color:#a52d10}.code{color:#582312}.placeholder{color:#98795e}

.code{word-break:break-all;overflow-wrap:anywhere;font-size:23rpx}
