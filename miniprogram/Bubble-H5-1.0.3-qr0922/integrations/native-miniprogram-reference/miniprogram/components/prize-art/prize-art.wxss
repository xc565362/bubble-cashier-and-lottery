.cash{height:85rpx;width:130rpx;display:flex;align-items:center;justify-content:center;background:#fff9e7;color:#69402d;border-radius:8rpx;position:relative}.cash::before,.cash::after{content:'';position:absolute;width:14rpx;height:14rpx;background:#fff9e7;border-radius:50%;top:35rpx}.cash::before{left:-7rpx}.cash::after{right:-7rpx}.amount{font-family:Arial,sans-serif;font-style:italic;font-weight:800;font-size:54rpx;letter-spacing:-2rpx}.currency{font-family:Arial,sans-serif;font-size:25rpx;font-weight:700;margin-top:15rpx;margin-right:3rpx}.product{width:150rpx;height:100rpx;display:block}

.cash{background:#ffe1b6;color:#b93010}.cash::before,.cash::after{background:#fff9e7}
