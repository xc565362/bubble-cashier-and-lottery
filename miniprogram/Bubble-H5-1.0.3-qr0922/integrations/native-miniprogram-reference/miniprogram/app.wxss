page{background:#fff9e7;color:#69402d;font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;font-size:26rpx}view,text,button,input{box-sizing:border-box}button{margin:0;padding:0;line-height:1.5;font-size:inherit;border-radius:0;background:transparent;color:inherit}button::after{border:0}button[disabled]{color:inherit;opacity:.55}.screen{padding-bottom:180rpx}.content{padding:0 38rpx}.kicker{font-size:17rpx;color:#69402d;letter-spacing:4rpx}.section-label{display:flex;align-items:center;font-size:29rpx;font-weight:650;margin-bottom:26rpx}.section-label::before{content:'';width:5rpx;height:27rpx;background:#fff9e7;margin-right:16rpx}.section-label .en{margin-left:auto;font-size:17rpx;font-weight:400;color:#69402d;letter-spacing:1rpx}.primary{background:#fff9e7;border:1rpx solid #e9bb98;color:#69402d;font-size:28rpx;font-weight:700;letter-spacing:1rpx;border-radius:18rpx;padding:26rpx 20rpx;width:100%;text-align:center}.secondary{width:100%;padding:23rpx 20rpx;border:1rpx solid #e9bb98;border-radius:17rpx;color:#69402d;font-size:24rpx;text-align:center}.text-button{font-size:20rpx;color:#69402d;display:inline-block}.page-heading{padding:48rpx 42rpx 36rpx}.page-title{font-size:52rpx;font-weight:750;letter-spacing:3rpx;margin:18rpx 0}.page-subtitle{font-size:23rpx;line-height:1.8;color:#69402d}.error-box{padding:28rpx;margin:24rpx 38rpx;border:1rpx solid #e9bb98;border-radius:15rpx;color:#69402d;font-size:24rpx;line-height:1.8}.error-box button{margin-top:20rpx}.loading{padding:70rpx 30rpx;text-align:center;color:#69402d;font-size:25rpx}.detail-box{margin:35rpx 40rpx;font-size:23rpx;line-height:1.9;color:#69402d}.detail-title{font-size:25rpx;font-weight:600;color:#69402d;margin:24rpx 0 12rpx}.detail-row{display:flex;justify-content:space-between;font-size:21rpx;padding:14rpx 0;border-bottom:1rpx solid #e9bb98;gap:15rpx}.detail-row text:last-child{color:#69402d;text-align:right}.large-art{height:190rpx;display:flex;align-items:center;justify-content:center;margin:10rpx 0}.large-art prize-art{transform:scale(1.65)}.modal-backdrop{position:fixed;inset:0;background:#fff9e7;z-index:30;display:flex;align-items:center;justify-content:center;padding:45rpx}.modal{position:relative;width:100%;border-radius:36rpx;background:#fff9e7;border:2rpx solid #e9bb98;text-align:center;padding:55rpx 45rpx 40rpx}.modal .sparkles{font-size:44rpx;letter-spacing:24rpx;color:#69402d;margin-bottom:28rpx}.modal .overline{font-size:16rpx;letter-spacing:4rpx;color:#69402d}.modal .title{font-size:48rpx;font-weight:750;margin:24rpx 0 8rpx}.modal .subtitle{font-size:23rpx;color:#69402d;line-height:1.9}.modal .win-name{font-size:40rpx;font-weight:650;color:#69402d;margin:12rpx 0 20rpx}.modal .primary{margin-top:32rpx}.modal .later{margin-top:25rpx;font-size:23rpx;color:#69402d}.empty{margin:35rpx 40rpx;padding:70rpx 40rpx;text-align:center;border:1rpx solid #e9bb98;border-radius:28rpx;background:#fff9e7}.empty .symbol{font-size:100rpx;color:#69402d}.empty .title{font-size:38rpx;font-weight:650;margin:25rpx 0}.empty .copy{font-size:24rpx;color:#69402d;line-height:1.9;margin-bottom:36rpx}

page{background:#ff652e;color:#582312}.primary{background:#c93613;color:#fff9e7;border-color:#c93613}.secondary{background:#fff9e7;color:#9f2a11;border-color:#c93613}.text-button{color:#7b2513}.kicker{color:#762b14}.section-label::before{background:#a52d10}.section-label .en{color:#762b14}.page-title{color:#582312}.page-subtitle{color:#6b2913}.detail-box{background:#fff9e7;border-radius:20rpx;padding:26rpx;color:#69402d}.detail-row{align-items:flex-start}.detail-row text:first-child{flex-shrink:0}.detail-row text:last-child{color:#582312}.detail-title{color:#a32c10}.modal-backdrop{background:rgba(68,24,7,.65)}.modal{background:#fff9e7;border-color:#edb58c;color:#582312}.modal .win-name{color:#c93613}.modal .overline{color:#a13c1b}.modal .sparkles{display:none}.modal .title{color:#582312}.modal .subtitle,.modal .later{color:#80543a}.loading,.error-box{background:#fff9e7;color:#582312}.empty{background:#fff9e7}.empty .symbol{color:#c93613}
